{
  "name": "vrtelemetry-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev:frontend": "cd src/frontend/VRTelemetry && npm run dev",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm:dev:frontend\" \"npm:dev:electron\"",

    "build:frontend": "cd src/frontend/VRTelemetry && npm install && npm run build",
    "build:backend": "pyinstaller build/backend.spec --distpath build/dist-backend --workpath build/work --noconfirm",
    "prepackage": "npm run build:frontend && npm run build:backend",
    "package": "npm run prepackage && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "com.yourlab.vrtelemetry",
    "productName": "VRTelemetry",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "src/frontend/VRTelemetry/dist",
        "to": "frontend"
      },
      {
        "from": "build/dist-backend/vrtelemetry-backend",
        "to": "backend"
      }
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.education" },
    "linux": { "target": "AppImage" }
  }
}