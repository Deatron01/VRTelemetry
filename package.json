{
  "name": "vrtelemetry-desktop",
  "productName": "VRTelemetry",
  "version": "1.2.2",
  "description": "VRTelemetry desktop app - research data acquisition for VR studies. Research use only; not a medical device.",
  "author": "Nagy István Bence",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/Deatron01/VRTelemetry",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev:frontend": "cd src/frontend/VRTelemetry && npm run dev",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm:dev:frontend\" \"npm:dev:electron\"",
    "build:frontend": "cd src/frontend/VRTelemetry && npm install && npm run build",
    "build:backend": "pyinstaller build/backend.spec --distpath build/dist-backend --workpath build/work --noconfirm",
    "build:legal": "node build/make-installer-license.js",
    "prepackage": "npm run build:legal && npm run build:frontend && npm run build:backend",
    "package": "npm run prepackage && electron-builder --publish never",
    "build:icons": "node build/make-icons.js"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "io.github.deatron01.vrtelemetry",
    "productName": "VRTelemetry",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "src/frontend/VRTelemetry/dist",
        "to": "frontend"
      },
      {
        "from": "build/dist-backend/vrtelemetry-backend",
        "to": "backend"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "DISCLAIMER.md",
        "to": "DISCLAIMER.md"
      }
    ],
    "publish": null,
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "build/installer-license.txt"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": "AppImage",
      "category": "Science",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
